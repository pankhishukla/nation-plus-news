# YouTube channel (defaults to Nation Plus News: @nationplusnewschannel)
YOUTUBE_CHANNEL_ID=UC1XZgFkx1petzD4pCRvxALQ
# Optional: YouTube Data API v3 key. Without it the site uses the public RSS
# feed (latest 15 uploads). With it, the latest 50 uploads incl. view counts.
YOUTUBE_API_KEY=

# Instagram handle shown in links
INSTAGRAM_USERNAME=nationplusnews_
# Instagram API (with Instagram Login) long-lived access token for the
# @nationplusnews_ professional account. Without it, Instagram sections show
# a "Follow us" card instead of posts.
INSTAGRAM_ACCESS_TOKEN=

# Optional: Google AdSense publisher id, e.g. ca-pub-1234567890
NEXT_PUBLIC_ADSENSE_CLIENT=
